<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:operaton="http://operaton.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_msg_x" name="msg_x" />
  <bpmn:process id="checkout-mini" name="Checkout Mini" isExecutable="true" operaton:historyTimeToLive="P30D">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_Start_To_TaskA</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_TaskA" sourceRef="StartEvent_1" targetRef="ServiceTask_A" />
    <bpmn:serviceTask id="ServiceTask_A" name="Service Task A"
                      operaton:asyncBefore="true"
                      operaton:delegateExpression="${taskADelegate}">
      <bpmn:incoming>Flow_Start_To_TaskA</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskA_To_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_TaskA_To_Gateway" sourceRef="ServiceTask_A" targetRef="Gateway_EventBased" />
    <bpmn:eventBasedGateway id="Gateway_EventBased" name="Event Based Gateway">
      <bpmn:incoming>Flow_TaskA_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_To_MsgX</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_To_Timer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_Gateway_To_MsgX" sourceRef="Gateway_EventBased" targetRef="CatchEvent_MsgX" />
    <bpmn:intermediateCatchEvent id="CatchEvent_MsgX" name="Message msg_x">
      <bpmn:incoming>Flow_Gateway_To_MsgX</bpmn:incoming>
      <bpmn:outgoing>Flow_MsgX_To_Merge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_msg_x" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_Gateway_To_Timer" sourceRef="Gateway_EventBased" targetRef="CatchEvent_Timer" />
    <bpmn:intermediateCatchEvent id="CatchEvent_Timer" name="Timer PT30S">
      <bpmn:incoming>Flow_Gateway_To_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_To_Merge</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_MsgX_To_Merge" sourceRef="CatchEvent_MsgX" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_Timer_To_Merge" sourceRef="CatchEvent_Timer" targetRef="Gateway_Merge" />
    <bpmn:exclusiveGateway id="Gateway_Merge" name="Merge Gateway">
      <bpmn:incoming>Flow_MsgX_To_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_Timer_To_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_To_TaskB</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Merge_To_TaskB" sourceRef="Gateway_Merge" targetRef="ServiceTask_B" />
    <bpmn:serviceTask id="ServiceTask_B" name="Service Task B"
                      operaton:delegateExpression="${taskBDelegate}">
      <bpmn:incoming>Flow_Merge_To_TaskB</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskB_To_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_TaskB_To_End" sourceRef="ServiceTask_B" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_TaskB_To_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="checkout-mini">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="109" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="185" y="152" width="25" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ServiceTask_A_di" bpmnElement="ServiceTask_A">
        <dc:Bounds x="270" y="87" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_EventBased_di" bpmnElement="Gateway_EventBased">
        <dc:Bounds x="425" y="102" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="419" y="72" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_CatchEvent_MsgX_di" bpmnElement="CatchEvent_MsgX">
        <dc:Bounds x="532" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="512" y="125" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_CatchEvent_Timer_di" bpmnElement="CatchEvent_Timer">
        <dc:Bounds x="532" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="518" y="215" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="625" y="102" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="611" y="78" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ServiceTask_B_di" bpmnElement="ServiceTask_B">
        <dc:Bounds x="730" y="87" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="892" y="109" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="900" y="152" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_TaskA_di" bpmnElement="Flow_Start_To_TaskA">
        <di:waypoint x="215" y="127" />
        <di:waypoint x="270" y="127" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TaskA_To_Gateway_di" bpmnElement="Flow_TaskA_To_Gateway">
        <di:waypoint x="370" y="127" />
        <di:waypoint x="425" y="127" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_To_MsgX_di" bpmnElement="Flow_Gateway_To_MsgX">
        <di:waypoint x="450" y="102" />
        <di:waypoint x="450" y="100" />
        <di:waypoint x="532" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_To_Timer_di" bpmnElement="Flow_Gateway_To_Timer">
        <di:waypoint x="450" y="152" />
        <di:waypoint x="450" y="190" />
        <di:waypoint x="532" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MsgX_To_Merge_di" bpmnElement="Flow_MsgX_To_Merge">
        <di:waypoint x="568" y="100" />
        <di:waypoint x="650" y="100" />
        <di:waypoint x="650" y="102" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timer_To_Merge_di" bpmnElement="Flow_Timer_To_Merge">
        <di:waypoint x="568" y="190" />
        <di:waypoint x="650" y="190" />
        <di:waypoint x="650" y="152" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Merge_To_TaskB_di" bpmnElement="Flow_Merge_To_TaskB">
        <di:waypoint x="675" y="127" />
        <di:waypoint x="730" y="127" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TaskB_To_End_di" bpmnElement="Flow_TaskB_To_End">
        <di:waypoint x="830" y="127" />
        <di:waypoint x="892" y="127" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
