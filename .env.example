# PostgreSQL Configuration
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379

# MinIO Configuration
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Keycloak Configuration
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.1
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Kafka & Debezium Connect Configuration
KAFKA_IMAGE=apache/kafka:3.9.0
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=9094
DEBEZIUM_CONNECT_IMAGE=debezium/connect:2.7.3.Final
KAFKA_CONNECT_PORT=8083

# System Service Credentials
DEBEZIUM_DB_PASSWORD=debezium_pass
KEYCLOAK_DB_PASSWORD=keycloak_pass
LITELLM_DB_PASSWORD=litellm_pass

# External Stubs Configuration
EXTERNAL_STUBS_PORT=8089

# Observability Configuration (Profile obs)
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.111.0
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_METRICS_PORT=8889

JAEGER_IMAGE=jaegertracing/all-in-one:1.60
JAEGER_UI_PORT=16686

PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
PROMETHEUS_PORT=9090

LOKI_IMAGE=grafana/loki:3.1.0
LOKI_PORT=3100

ALLOY_IMAGE=grafana/alloy:v1.3.1
ALLOY_PORT=12345
ALLOY_HTTP_RECEIVER_PORT=9999

GRAFANA_IMAGE=grafana/grafana:11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
